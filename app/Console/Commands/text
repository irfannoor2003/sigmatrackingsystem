<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\Cache;
use App\Models\Attendance;
use Carbon\Carbon;

class BiometricListener extends Command
{
    protected $signature = 'biometric:listen';
    protected $description = 'Listen for Feteck scanner and update the attendances table.';

    public function handle()
    {
        $port = 5055;
        $socket = socket_create(AF_INET, SOCK_DGRAM, SOL_UDP);

        if (!socket_bind($socket, '0.0.0.0', $port)) {
            $this->error("Port $port is busy. Close other terminal windows.");
            return;
        }

        $this->info("Listening for Salesman Fingerprints...");

        while (true) {
            $from = '';
            $port_received = 0;
            socket_recvfrom($socket, $buf, 1024, 0, $from, $port_received);

            $bytes = unpack("C*", $buf);
            $userId = $bytes[9] ?? null;

            // Ignore status packets (204/cc) and null IDs
            if ($userId && $userId > 0 && $userId != 204) {

                $cacheKey = "biometric_debounce_{$userId}";

                if (!Cache::has($cacheKey)) {
                    $this->processAttendance($userId, $from);
                    Cache::put($cacheKey, true, 30); // 30-second cooldown
                }
            }
        }
    }

    protected function processAttendance($userId, $ip)
    {
        $today = Carbon::today()->toDateString();
        $now = Carbon::now();

        // 1. Find or Create the attendance record for today
        $attendance = Attendance::firstOrNew([
            'salesman_id' => $userId,
            'date'        => $today
        ]);

        if (!$attendance->exists) {
            // --- CLOCK IN ---
            $attendance->status = 'present';
            $attendance->clock_in = $now;
            $attendance->checkin_method = 'biometric';
            $attendance->checkin_ip = $ip;
            $attendance->office_verified = true; // Physical device = verified
            $attendance->save();

            $this->info("User $userId: Clocked IN at " . $now->toTimeString());
        } else {
            // --- CLOCK OUT ---
            // Update clock_out every time they scan after the first time
            $attendance->clock_out = $now;

            // Calculate total minutes if clock_in exists
            if ($attendance->clock_in) {
                $attendance->total_minutes = $now->diffInMinutes($attendance->clock_in);
            }

            $attendance->save();
            $this->warn("User $userId: Clocked OUT/Updated at " . $now->toTimeString());
        }
    }
}
